---
// Public, print-style menu card: the orange A4 layout the owner prints from
// the admin Menu builder (Other_resource/Menu_Original.pdf), but with EVERY
// active product from the live catalogue, grouped by category and subcategory.
// lib/menu-board.js lays out the pages for both this page and the admin preview.
//
// The A4 pages render at true size on desktop and scale down to fit the
// viewport on mobile (same pages, just smaller). "Print / Save as PDF" prints
// them edge-to-edge in orange, exactly like the original PDF.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { CATEGORIES } from "../lib/categories";
import { buildMenuModel, toBoardPayload } from "../lib/menu-model.js";
import { parseGstSettings } from "../lib/pricing.js";
import { seed } from "../lib/seed";

// Copy printed on the card (header on page 1, footer on the last page).
const DOC = {
  tagline: "Handcrafted daily · Swiss soul, Bengali heart",
  strapline: "ALL PRICES AUD · DINE-IN & TAKEAWAY",
  footer: "Baked fresh every morning",
  location: "SWISS · BAKERY · MINTO",
};

// Build-time snapshot, shown until the live API answers. "<" is escaped so no
// name can close the <script> tag it sits in.
const INITIAL = {
  doc: DOC,
  gst: parseGstSettings(),
  categories: toBoardPayload(buildMenuModel({ categories: CATEGORIES, products: seed.products })),
};
const initialJson = JSON.stringify(INITIAL).replace(/</g, "\\u003c");
---

<Layout
  title="Menu · Swiss Bakery & Sweets · Minto NSW"
  description="The full Swiss Bakery & Sweets menu — Swiss patisserie, fresh patties and rolls, and traditional Bengali sweets. All prices in AUD, dine-in & takeaway. Baked daily in Minto, NSW."
>
  <Nav />
  <main id="top">
    <section class="menu-band">
      <div class="container-x text-center pt-12 sm:pt-16">
        <span class="chip chip-cream mb-3">The menu</span>
        <h1 class="section-title text-3xl sm:text-4xl text-[color:var(--color-charcoal)]">
          Swiss Bakery &amp; Sweets — the full menu
        </h1>
        <p class="mt-4 max-w-2xl mx-auto text-[color:var(--color-muted)]">
          Every active item, priced in AUD. Baked on-site in Minto, NSW.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3 print:hidden">
          <button id="menu-print" type="button" class="btn-primary">Print / Save as PDF</button>
          <a href="/#menu" class="btn-outline">Browse with photos</a>
        </div>
      </div>

      <div id="stage" class="stage" aria-label="Swiss Bakery menu pages">
        <div class="empty">Loading menu…</div>
      </div>
    </section>
  </main>
  <Footer />

  <script type="application/json" id="menu-data" set:html={initialJson}></script>

  <script>
    import { fetchLiveJson } from "../lib/live-api.js";
    import { fitPagesToWidth, paginateMenu } from "../lib/menu-board.js";
    import { buildMenuModel, toBoardPayload } from "../lib/menu-model.js";
    import { formatPriceLines, parseGstSettings } from "../lib/pricing.js";

    const menuData = JSON.parse(document.getElementById("menu-data")?.textContent ?? "{}");
    let gst = menuData.gst ?? parseGstSettings();

    const render = (categories: unknown[]) => {
      const stage = document.getElementById("stage");
      if (!stage) return;
      if (categories.length === 0) {
        stage.innerHTML = '<div class="empty">Menu is being updated — please check back shortly.</div>';
        return;
      }
      paginateMenu(stage, { doc: menuData.doc, categories }, { formatPriceLines, gst });
      fitPagesToWidth(stage);
    };

    const start = () => {
      render(menuData.categories ?? []);

      // Rebuild from the live catalogue: categories, subcategories, products and the GST setting.
      Promise.all([fetchLiveJson("/api/categories"), fetchLiveJson("/api/products"), fetchLiveJson("/api/settings")]).then(
        ([categoriesData, productsData, settingsData]) => {
          if (settingsData?.settings) gst = parseGstSettings(settingsData.settings);
          const isCatalogueLoaded = Array.isArray(categoriesData?.categories) && Array.isArray(productsData?.products);
          if (isCatalogueLoaded) {
            render(toBoardPayload(buildMenuModel({ categories: categoriesData.categories, products: productsData.products })));
          } else if (settingsData?.settings) {
            render(menuData.categories ?? []);
          }
        },
      );

      let frame = 0;
      window.addEventListener("resize", () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const stage = document.getElementById("stage");
          if (stage) fitPagesToWidth(stage);
        });
      });
      document.getElementById("menu-print")?.addEventListener("click", () => window.print());
    };

    // Lay out after the web fonts load, so the measurements are right.
    if (document.fonts?.ready) {
      document.fonts.ready.then(start).catch(start);
    } else {
      start();
    }
  </script>
</Layout>

<style is:global>
  /* Orange A4 menu card — palette & layout ported verbatim from
     /admin/menu-preview.html so this page matches Menu_Original.pdf. */
  .menu-band {
    --paper: #f37020;
    --ink: #1c1715;
    --gold: #ffffff;
    --gold-soft: rgba(255, 255, 255, 0.6);
    --price: #ffffff;
    --muted: rgba(28, 23, 21, 0.55);
    background: #4a4f59;
    padding-bottom: 4rem;
  }
  .menu-band .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 28px 16px 16px;
  }
  .menu-band .page-fit {
    position: relative;
    margin: 0 auto;
    max-width: 100%;
  }
  .menu-band .page {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--paper);
    width: 210mm;
    /* Definite height (not just min-height) so .page-body's height:100% resolves
       and the absolutely-positioned footer pins to the true A4 page bottom — a
       min-height parent leaves the body content-sized, which mis-pins the footer
       and forces it onto its own empty extra page. */
    height: 297mm;
    min-height: 297mm;
    padding: 18mm 18mm 22mm;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28);
    box-sizing: border-box;
    color: var(--ink);
    font-family: "Montserrat", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .menu-band .page * { box-sizing: border-box; }
  .menu-band .frame {
    position: absolute;
    inset: 8mm;
    border: 1.5px solid var(--gold);
    pointer-events: none;
  }
  .menu-band .frame::after {
    content: "";
    position: absolute;
    inset: 2.5mm;
    border: 0.6px solid var(--gold);
  }
  .menu-band .page-body { position: relative; height: 100%; }
  .menu-band .header { position: relative; text-align: center; padding-top: 4mm; }
  .menu-band .logo {
    width: 26mm;
    height: 26mm;
    margin: 0 auto 4mm;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 2px 6px rgba(26, 42, 79, 0.12);
  }
  .menu-band .logo img { width: 100%; height: 100%; object-fit: contain; padding: 1mm; }
  .menu-band .tagline {
    font-family: "Playfair Display", serif;
    font-style: italic;
    color: var(--ink);
    font-size: 13pt;
    margin: 0 0 2mm;
  }
  .menu-band .strapline {
    color: var(--gold);
    letter-spacing: 0.18em;
    font-size: 8pt;
    font-weight: 600;
  }
  .menu-band .top-divider { margin: 6mm auto 5mm; height: 1px; background: var(--gold); opacity: 0.5; }
  .menu-band .cat-headblock { margin: 0 0 1mm; padding-top: 0.1px; }
  .menu-band .cat-head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 7mm;
    margin: 2mm 0 1mm;
  }
  .menu-band .cat-head .rule { height: 1px; background: var(--gold); opacity: 0.55; }
  .menu-band .cat-head h2 {
    font-family: "Playfair Display", serif;
    color: var(--ink);
    font-weight: 700;
    font-size: 17pt;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .menu-band .cat-sub {
    font-family: "Playfair Display", serif;
    font-style: italic;
    color: var(--gold);
    text-align: center;
    font-size: 9pt;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 4mm;
  }
  .menu-band .items { display: grid; gap: 0.8mm 8mm; }
  .menu-band .items.cols-1 { grid-template-columns: 1fr; }
  .menu-band .items.cols-2 { grid-template-columns: 1fr 1fr; }
  .menu-band .items.cols-3 { grid-template-columns: 1fr 1fr 1fr; }
  .menu-band .items.cols-4 { grid-template-columns: 1fr 1fr 1fr 1fr; }
  .menu-band .item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 4mm;
    padding: 0.7mm 0;
    font-size: 10.5pt;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .menu-band .item.with-photo { grid-template-columns: 11mm 1fr auto; align-items: center; }
  .menu-band .item .thumb {
    width: 11mm;
    height: 11mm;
    background: #fff center / cover no-repeat;
    border: 0.6px solid var(--gold);
    border-radius: 50%;
  }
  .menu-band .item .name { color: var(--ink); font-weight: 500; }
  .menu-band .item .price {
    color: var(--gold);
    font-weight: 700;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .menu-band .item .price.muted { color: var(--muted); font-style: italic; font-weight: 500; }
  .menu-band .item .price span { display: block; text-align: right; }
  /* Subcategory heading inside a category band (menu-board.js) */
  .menu-band .sub-head { display: flex; align-items: center; gap: 3mm; padding: 2.2mm 0 1.2mm; }
  .menu-band .sub-label {
    color: var(--ink);
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .menu-band .sub-rule { flex: 1; height: 1px; background: var(--gold); opacity: 0.5; }
  .menu-band .footer { position: absolute; bottom: 12mm; left: 18mm; right: 18mm; text-align: center; }
  .menu-band .footer .note {
    font-family: "Playfair Display", serif;
    font-style: italic;
    color: var(--ink);
    font-size: 10pt;
    margin: 0 0 1.5mm;
  }
  .menu-band .footer .loc { color: var(--gold); letter-spacing: 0.22em; font-size: 8pt; font-weight: 600; }
  .menu-band .empty {
    text-align: center;
    padding: 4rem 1.5rem;
    color: #fff;
    font-family: "Playfair Display", serif;
    font-style: italic;
  }

  @media print {
    /* Print only the orange A4 pages, edge-to-edge, like the original PDF. */
    body { background: var(--paper) !important; }
    header, footer, .menu-band > .container-x { display: none !important; }
    .menu-band { background: var(--paper) !important; padding: 0 !important; }
    .menu-band .stage { padding: 0 !important; gap: 0 !important; display: block !important; }
    .menu-band .page-fit { width: auto !important; height: auto !important; margin: 0 !important; }
    .menu-band .page {
      position: static !important;
      transform: none !important;
      box-shadow: none !important;
      margin: 0 !important;
      width: 210mm !important;
      height: 297mm !important;
      min-height: 297mm !important;
      page-break-after: always;
      break-after: page;
    }
    .menu-band .page-fit:last-child .page {
      page-break-after: auto;
      break-after: auto;
    }
  }
  @page { size: A4 portrait; margin: 0; }
</style>
