---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import NoticeStrip from "../components/NoticeStrip.astro";
import Hero from "../components/Hero.astro";
import Featured from "../components/Featured.astro";
import Menu from "../components/Menu.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---
<Layout>
  <NoticeStrip />
  <Nav />
  <h1 class="sr-only">Swiss Bakery &amp; Sweets · Swiss patisserie and Bengali sweets in Minto, NSW</h1>
  <main>
    <Hero />
    <Featured />
    <Menu />
    <About />
    <Contact />
  </main>
  <Footer />
  <script>
    import { fetchLiveJson } from "../lib/live-api.js";
    import { renderMenuNav, renderMenuSections, renderProductCard } from "../lib/menu-html.js";
    import { buildMenuModel, featuredProducts } from "../lib/menu-model.js";
    import { parseGstSettings } from "../lib/pricing.js";

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12 },
    );
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

    // Subcategory chips: show one subcategory of a category, or all of it.
    document.getElementById("menu-sections")?.addEventListener("click", (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-sub-filter]");
      const section = chip?.closest("[data-category]");
      if (!chip || !section) return;
      const filter = chip.dataset.subFilter ?? "";
      section.querySelectorAll("[data-sub-filter]").forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      section.querySelectorAll<HTMLElement>("[data-sub-group]").forEach((group) => {
        group.hidden = filter !== "" && group.dataset.subGroup !== filter;
      });
    });

    // Re-render the featured strip and the whole menu from the live catalogue:
    // the static HTML is a build-time snapshot, and categories, subcategories
    // and products are all edited in the admin since then.
    Promise.all([fetchLiveJson("/api/categories"), fetchLiveJson("/api/products"), fetchLiveJson("/api/settings")]).then(
      ([categoriesData, productsData, settingsData]) => {
        if (!Array.isArray(productsData?.products)) return;
        const gst = parseGstSettings(settingsData?.settings);
        const featuredScroll = document.getElementById("featured-scroll");
        if (featuredScroll) {
          featuredScroll.innerHTML = featuredProducts(productsData.products)
            .map((p) => renderProductCard(p, gst, { size: "sm" }))
            .join("");
        }

        const nav = document.getElementById("menu-nav");
        const sections = document.getElementById("menu-sections");
        if (!nav || !sections || !Array.isArray(categoriesData?.categories)) return;
        // A link to a category that only exists live (#cat-new-thing) has nothing
        // to scroll to until the render below, so scroll once it's there.
        const hashTarget = location.hash.slice(1);
        const isHashPending = hashTarget !== "" && !document.getElementById(hashTarget);
        const model = buildMenuModel({ categories: categoriesData.categories, products: productsData.products });
        nav.innerHTML = renderMenuNav(model);
        sections.innerHTML = renderMenuSections(model, gst, { isInteractive: true });
        if (isHashPending) document.getElementById(hashTarget)?.scrollIntoView();
      },
    );
  </script>
</Layout>
