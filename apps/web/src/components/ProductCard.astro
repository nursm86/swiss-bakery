---
import type { SeedProduct } from "../lib/seed";
import { renderProductCard } from "../lib/menu-html.js";
import { parseGstSettings } from "../lib/pricing.js";

interface Props {
  product: SeedProduct;
  size?: "sm" | "md";
}

const { product, size = "md" } = Astro.props;
// Build-time default (GST on, 10%); the homepage script re-renders with the live setting.
---
<Fragment set:html={renderProductCard(product, parseGstSettings(), { size })} />
