---
import { CATEGORIES } from "../lib/categories";
import { buildMenuModel } from "../lib/menu-model.js";
import { renderMenuNav, renderMenuSections } from "../lib/menu-html.js";
import { parseGstSettings } from "../lib/pricing.js";
import { seed } from "../lib/seed";

// Build-time snapshot (data/categories.json + data/products.seed.json). The
// homepage script re-renders the pills and sections from the live API.
const model = buildMenuModel({ categories: CATEGORIES, products: seed.products });
---
<section id="menu" class="py-14 sm:py-20 bg-white">
  <div class="container-x">
    <div class="text-center max-w-2xl mx-auto">
      <span class="chip chip-cream mb-3">Full menu</span>
      <h2 class="section-title text-3xl sm:text-4xl">Swiss Bakery &amp; Sweets menu — baked, boxed, served warm</h2>
      <p class="mt-4 text-[color:var(--color-muted)]">
        Everything on the Swiss Bakery &amp; Sweets menu is baked on-site in Minto NSW. Bengali items come with a quick sensory note so newcomers know what to expect.
      </p>
      <div class="mt-6 flex justify-center">
        <a href="/menu" class="btn-outline">View &amp; print the full menu card →</a>
      </div>
    </div>

    <nav id="menu-nav" class="mt-10 flex flex-wrap justify-center gap-2 text-sm" set:html={renderMenuNav(model)} />
    <div id="menu-sections" set:html={renderMenuSections(model, parseGstSettings())} />
  </div>
</section>
