// Swiss Bakery - Prisma schema
//
// Provider: MySQL / MariaDB (cPanel-compatible).
// @db.Text is used for free-form fields so long descriptions aren't truncated to VARCHAR(191).

generator client {
  provider      = "prisma-client-js"
  // Output the generated client into a repo-internal, committed path so the
  // cPanel server can skip `prisma generate` entirely (CloudLinux LVE was
  // SIGABRT-killing the generator's WASM engine on shared hosting).
  // Build locally, commit `apps/api/prisma-client/`, deploy.
  output        = "../prisma-client"
  // `native` covers the developer's host. The cPanel server at au-s1
  // runs Debian with OpenSSL 1.0.x (confirmed from the Prisma runtime
  // error). `rhel-openssl-3.0.x` is kept as a safety net in case the
  // hosting environment changes.
  binaryTargets = ["native", "debian-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  category    String
  priceCents  Int?
  unit        String   @default("piece")
  qty         Int      @default(1)
  description String?  @db.Text
  imagePath   String?
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // category holds Category.key (no foreign key: the API checks it exists).
  // subcategoryId is optional and must belong to that category.
  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([category, sortOrder])
  @@index([isFeatured])
  @@index([subcategoryId])
}

// Product categories, edited in the admin. key is what Product.category stores
// and slug is the #cat-<slug> anchor on the homepage; neither changes after
// creation, so renaming the label never orphans products or breaks links.
model Category {
  id            Int           @id @default(autoincrement())
  key           String        @unique @db.VarChar(40)
  label         String        @db.VarChar(80)
  slug          String        @unique @db.VarChar(80)
  blurb         String        @default("") @db.VarChar(300)
  menuSubtitle  String        @default("") @db.VarChar(120)
  menuColumns   Int           @default(2)
  sortOrder     Int           @default(0)
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([sortOrder])
}

model Subcategory {
  id         Int       @id @default(autoincrement())
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String    @db.VarChar(60)
  slug       String    @db.VarChar(80)
  sortOrder  Int       @default(0)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
}

model HeroBanner {
  id         Int      @id @default(autoincrement())
  heading    String
  subheading String?
  ctaLabel   String?
  ctaHref    String?
  imagePath  String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Notice {
  id        Int       @id @default(autoincrement())
  message   String    @db.Text
  level     String    @default("info")
  isActive  Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id
  subject   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([subject])
}

model Page {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  content     String   @db.Text
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}
